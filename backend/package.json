{
  "name": "life-rpg-backend",
  "version": "1.0.0",
  "description": "Production-ready Life RPG Backend Engine with Supabase, Non-Linear Progression, and Streak Tracking",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "db:init": "tsx src/database/init.ts",
    "db:seed": "tsx src/database/seed.ts",
    "test": "tsx tests/progression.test.ts"
  },
  "keywords": [
    "life-rpg",
    "supabase",
    "express",
