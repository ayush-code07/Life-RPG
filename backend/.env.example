# ==============================================
# SERVER CONFIGURATION
# ==============================================
PORT=5000
NODE_ENV=development

# ==============================================
# SUPABASE / POSTGRESQL DATABASE CONFIGURATION
# ==============================================
# Use Direct Connection String or Session Pooler (port 5432 or 6543)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_TIMEOUT_MS=10000

# ==============================================
# SUPABASE AUTH CONFIGURATION
# ==============================================
# Found in: Supabase Dashboard > Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-for-testing-only

# ==============================================
# CORS CONFIGURATION
# ==============================================
CORS_ORIGIN=*
